{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2023",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "@app/auth": ["./libs/auth/src/index.ts"],
      "@app/auth/*": ["./libs/auth/src/*"],
      "@app/cache": ["./libs/cache/src/index.ts"],
      "@app/cache/*": ["./libs/cache/src/*"],
      "@app/common": ["./libs/common/src/index.ts"],
      "@app/common/*": ["./libs/common/src/*"],
      "@app/crypot": ["./libs/crypot/src/index.ts"],
      "@app/crypot/*": ["./libs/crypot/src/*"],
      "@app/database": ["./libs/database/src/index.ts"],
      "@app/database/*": ["./libs/database/src/*"],
      "@app/logger": ["./libs/logger/src/index.ts"],
      "@app/logger/*": ["./libs/logger/src/*"],
      "@app/permission": ["./libs/permission/src/index.ts"],
      "@app/permission/*": ["./libs/permission/src/*"],
      "@app/storage": ["./libs/storage/src/index.ts"],
      "@app/storage/*": ["./libs/storage/src/*"],
      "@app/swagger": ["./libs/swagger/src/index.ts"],
      "@app/swagger/*": ["./libs/swagger/src/*"]
    },
    "resolvePackageJsonExports": true,
    "types": ["vitest/globals", "node"],
    "strict": true,
    "strictPropertyInitialization": false,
    "declaration": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
