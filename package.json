  "scripts": {
    "build": "nest build gateway",
    "deploy": "nest deploy",
    "start": "cross-env NODE_ENV=development nest start gateway",
    "start:dev": "cross-env NODE_ENV=development nest start gateway --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/gateway/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.{ts,js} libs/**/*.{ts,js}\"",
    "clean": "node ./script/clean.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "ruoyi:phase0": "node script/ruoyi/phase0.mjs",
    "test:ruoyi-phase0": "node --test script/ruoyi/phase0.test.mjs"
  },
