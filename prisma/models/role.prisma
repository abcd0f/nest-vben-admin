enum DataScope {
  ALL
  DEPT_AND_CHILDREN
  DEPT
  CUSTOM
  SELF
}

/// 系统角色
model Role {
  roleId    BigInt    @id @default(autoincrement()) @map("role_id")
  roleCode  String    @unique @map("role_code") @db.VarChar(64)
  roleName  String    @map("role_name") @db.VarChar(64)
  dataScope DataScope @default(SELF) @map("data_scope")
  status    Int       @default(1) @db.SmallInt
  isSystem  Boolean   @default(false) @map("is_system")
  createdTime DateTime  @default(now()) @map("created_time") @db.Timestamptz(3)
  updatedTime DateTime  @updatedAt @map("updated_time") @db.Timestamptz(3)
  deletedTime DateTime? @map("deleted_time") @db.Timestamptz(3)

  users UserRole[]
  depts RoleDept[]
  menus RoleMenu[]

  @@index([deletedTime])
  @@map("sys_role")
}

model UserPost {
  userId BigInt @map("user_id")
  postId BigInt @map("post_id")
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  post   Post   @relation(fields: [postId], references: [postId], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("sys_user_post")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("sys_user_role")
}

model RoleDept {
  roleId BigInt @map("role_id")
  deptId BigInt @map("dept_id")
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: Cascade)
  dept   Dept   @relation(fields: [deptId], references: [deptId], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, deptId])
  @@index([deptId])
  @@map("sys_role_dept")
}

enum MenuType {
  DIRECTORY
  MENU
  ACTION
}

model Menu {
  menuId         BigInt    @id @default(autoincrement()) @map("menu_id")
  parentId       BigInt?   @map("parent_id")
  menuType       MenuType  @map("menu_type")
  menuName       String    @map("menu_name") @db.VarChar(64)
  routePath      String?   @map("route_path") @db.VarChar(255)
  component      String?   @db.VarChar(255)
  permissionCode String?   @unique @map("permission_code") @db.VarChar(128)
  sortOrder      Int       @default(0) @map("sort_order") @db.SmallInt
  status         Int       @default(1) @db.SmallInt
  createdTime      DateTime  @default(now()) @map("created_time") @db.Timestamptz(3)
  updatedTime      DateTime  @updatedAt @map("updated_time") @db.Timestamptz(3)
  deletedTime      DateTime? @map("deleted_time") @db.Timestamptz(3)

  parent   Menu?      @relation("MenuTree", fields: [parentId], references: [menuId], onDelete: Restrict, onUpdate: Cascade)
  children Menu[]     @relation("MenuTree")
  roles    RoleMenu[]

  @@index([parentId])
  @@index([deletedTime])
  @@map("sys_menu")
}

model RoleMenu {
  roleId BigInt @map("role_id")
  menuId BigInt @map("menu_id")
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [menuId], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, menuId])
  @@index([menuId])
  @@map("sys_role_menu")
}
