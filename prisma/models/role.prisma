/// 系统角色模型
/// 对应数据库表 sys_role
model Role {
  /// 角色唯一标识
  roleId BigInt @id @map("role_id")

  /// 租户ID
  tenantId String @default("000000") @map("tenant_id") @db.VarChar(20)

  /// 角色名称
  roleName String @map("role_name") @db.VarChar(30)

  /// 角色权限字符串
  roleKey String @map("role_key") @db.VarChar(100)

  /// 显示顺序
  roleSort Int @default(0) @map("role_sort")

  /// 数据范围：'1' 全部数据权限 '2' 自定义数据权限 '3' 本部门数据权限 '4' 本部门及以下数据权限 '5' 仅本人数据权限 '6' 本部门及以下或本人
  dataScope String @default("1") @map("data_scope") @db.Char(1)

  /// 菜单树选择项是否关联显示
  menuCheckStrictly Boolean @default(true) @map("menu_check_strictly")

  /// 部门树选择项是否关联显示
  deptCheckStrictly Boolean @default(true) @map("dept_check_strictly")

  /// 角色状态：'0' 正常 '1' 停用
  status String @default("0") @map("status") @db.Char(1)

  /// 删除标志：'0' 未删除 '2' 已删除
  delFlag String @default("0") @map("del_flag") @db.Char(1)

  /// 创建部门
  createDept BigInt? @map("create_dept")

  /// 创建者
  createBy BigInt? @map("create_by")

  /// 创建时间
  createTime DateTime @default(now()) @map("create_time") @db.Timestamptz(3)

  /// 更新者
  updateBy BigInt? @map("update_by")

  /// 更新时间
  updateTime DateTime @updatedAt @map("update_time") @db.Timestamptz(3)

  /// 备注
  remark String? @map("remark") @db.VarChar(500)

  /// 关联的用户-角色关系（多对多中间表）
  users UserRole[]
  /// 关联的角色-部门关系（自定义数据权限用）
  depts RoleDept[]
  /// 关联的角色-菜单关系（菜单权限用）
  menus RoleMenu[]

  /// 为租户ID建立索引
  @@index([tenantId])
  /// 为删除标志建立索引
  @@index([delFlag])
  /// 指定数据库表名为 sys_role
  @@map("sys_role")
}

/// 用户-岗位关联模型（多对多中间表）
/// 对应数据库表 sys_user_post
model UserPost {
  /// 用户 ID
  userId BigInt @map("user_id")
  /// 岗位 ID
  postId BigInt @map("post_id")
  /// 关联的用户
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  /// 关联的岗位
  post   Post   @relation(fields: [postId], references: [postId], onDelete: Cascade, onUpdate: Cascade)

  /// 联合主键：用户 + 岗位
  @@id([userId, postId])
  /// 为岗位外键建立索引
  @@index([postId])
  /// 指定数据库表名为 sys_user_post
  @@map("sys_user_post")
}

/// 用户-角色关联模型（多对多中间表）
/// 对应数据库表 sys_user_role
model UserRole {
  /// 用户 ID
  userId BigInt @map("user_id")
  /// 角色 ID
  roleId BigInt @map("role_id")
  /// 关联的用户
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  /// 关联的角色
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: Cascade)

  /// 联合主键：用户 + 角色
  @@id([userId, roleId])
  /// 为角色外键建立索引
  @@index([roleId])
  /// 指定数据库表名为 sys_user_role
  @@map("sys_user_role")
}

/// 角色-部门关联模型（用于角色自定义数据权限）
/// 对应数据库表 sys_role_dept
model RoleDept {
  /// 角色 ID
  roleId BigInt @map("role_id")
  /// 部门 ID
  deptId BigInt @map("dept_id")
  /// 关联的角色
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: Cascade)
  /// 关联的部门
  dept   Dept   @relation(fields: [deptId], references: [deptId], onDelete: Cascade, onUpdate: Cascade)

  /// 联合主键：角色 + 部门
  @@id([roleId, deptId])
  /// 为部门外键建立索引
  @@index([deptId])
  /// 指定数据库表名为 sys_role_dept
  @@map("sys_role_dept")
}

/// 系统菜单/权限模型
/// 对应数据库表 sys_menu
model Menu {
  /// 菜单唯一标识
  menuId BigInt @id @map("menu_id")

  /// 菜单名称
  menuName String @map("menu_name") @db.VarChar(50)

  /// 父菜单ID，0 表示顶级菜单
  parentId BigInt @default(0) @map("parent_id")

  /// 显示顺序
  orderNum Int @default(0) @map("order_num")

  /// 路由地址
  path String? @map("path") @db.VarChar(200)

  /// 组件路径
  component String? @map("component") @db.VarChar(255)

  /// 路由参数
  queryParam String? @map("query_param") @db.VarChar(255)

  /// 是否为外链：1 是 0 否
  isFrame String @default("1") @map("is_frame") @db.Char(1)

  /// 是否缓存：1 缓存 0 不缓存
  isCache String @default("0") @map("is_cache") @db.Char(1)

  /// 菜单类型：M 目录 C 菜单 F 按钮
  menuType String @map("menu_type") @db.Char(1)

  /// 显示状态：1 显示 0 隐藏
  visible String @default("1") @map("visible") @db.Char(1)

  /// 菜单状态：'0' 正常 '1' 停用
  status String @default("0") @map("status") @db.Char(1)

  /// 权限标识
  perms String? @map("perms") @db.VarChar(100)

  /// 菜单图标
  icon String? @map("icon") @db.VarChar(100)

  /// 创建部门
  createDept BigInt? @map("create_dept")

  /// 创建者
  createBy BigInt? @map("create_by")

  /// 创建时间
  createTime DateTime @default(now()) @map("create_time") @db.Timestamptz(3)

  /// 更新者
  updateBy BigInt? @map("update_by")

  /// 更新时间
  updateTime DateTime @updatedAt @map("update_time") @db.Timestamptz(3)

  /// 备注
  remark String? @map("remark") @db.VarChar(500)

  /// 关联的角色-菜单关系（菜单权限用）
  roles RoleMenu[]

  /// 为父菜单ID建立索引
  @@index([parentId])
  /// 指定数据库表名为 sys_menu
  @@map("sys_menu")
}

/// 角色-菜单关联模型（菜单权限）
/// 对应数据库表 sys_role_menu
model RoleMenu {
  /// 角色 ID
  roleId BigInt @map("role_id")
  /// 菜单 ID
  menuId BigInt @map("menu_id")
  /// 关联的角色
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade, onUpdate: Cascade)
  /// 关联的菜单
  menu   Menu   @relation(fields: [menuId], references: [menuId], onDelete: Cascade, onUpdate: Cascade)

  /// 联合主键：角色 + 菜单
  @@id([roleId, menuId])
  /// 为菜单外键建立索引
  @@index([menuId])
  /// 指定数据库表名为 sys_role_menu
  @@map("sys_role_menu")
}
