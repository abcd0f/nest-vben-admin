# ============================================================
# 环境变量模板 —— 复制为 .env.development / .env.production 后按需修改
# 本文件会提交到仓库，禁止写入真实凭据。
#
# 加载优先级（高 → 低）：
#   1. shell / 容器注入的环境变量
#   2. .env.<NODE_ENV>.local → .env.<NODE_ENV> → .env.local → .env
# ============================================================

# 运行环境：development | test | production
NODE_ENV=development

# HTTP 服务端口
PORT=3000

# ---------- PostgreSQL ----------
# 开发环境示例（本地）
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# 正式环境示例（务必启用 TLS；凭据从密钥管理系统注入，不要写死在仓库里）
# DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/DATABASE?schema=public&sslmode=require

# ---------- 连接池 ----------
# 单实例最大连接数。注意：总连接数 = 实例数 × DATABASE_POOL_MAX，
# 不要超过 PostgreSQL 的 max_connections。
DATABASE_POOL_MAX=10
# 空闲连接回收时间（毫秒）
DATABASE_POOL_IDLE_TIMEOUT=10000
# 建立连接超时（毫秒）
DATABASE_CONNECT_TIMEOUT=5000

# ---------- 调试 ----------
# 是否打印 SQL 日志。生产环境务必保持 false
DATABASE_LOG_QUERIES=false

# ---------- 日志 ----------
# 注意：控制台输出由 Nest 自带的 ConsoleLogger 负责，样式不受这些变量影响。
# 以下配置只作用于 pino 写入的日志文件。
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# 是否写入日志文件：logs/app-YYYY-MM-DD.log（全量）、logs/error-YYYY-MM-DD.log（仅 error 及以上）
LOG_FILE=true
# 日志文件目录
LOG_DIR=logs
# 追加脱敏路径（逗号分隔）。默认已覆盖 authorization / cookie / password / token
# LOG_REDACT=req.headers["x-custom-secret"],*.idCard
