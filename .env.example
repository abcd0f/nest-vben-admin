# ============================================================
# 环境变量模板 —— 复制为 .env.development / .env.production 后按需修改
# 本文件会提交到仓库，禁止写入真实凭据。
#
# 加载优先级（高 → 低）：
#   1. shell / 容器注入的环境变量
#   2. .env.<NODE_ENV>.local → .env.<NODE_ENV> → .env.local → .env
# ============================================================

# 运行环境：development | test | production
NODE_ENV=development

# HTTP 服务端口
PORT=3000

# ---------- PostgreSQL ----------
# 开发环境示例（本地）
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# 正式环境示例（务必启用 TLS；凭据从密钥管理系统注入，不要写死在仓库里）
# DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/DATABASE?schema=public&sslmode=require

# ---------- 连接池 ----------
# 单实例最大连接数。注意：总连接数 = 实例数 × DATABASE_POOL_MAX，
# 不要超过 PostgreSQL 的 max_connections。
DATABASE_POOL_MAX=10
# 空闲连接回收时间（毫秒）
DATABASE_POOL_IDLE_TIMEOUT=10000
# 建立连接超时（毫秒）
DATABASE_CONNECT_TIMEOUT=5000

# ---------- 调试 ----------
# 是否打印 SQL 日志。生产环境务必保持 false
DATABASE_LOG_QUERIES=false

# ---------- Redis（缓存 / 分布式锁） ----------
# 是否启用。默认 false —— 不启用时不建立任何连接，也不要求 REDIS_URL；
# 此时调用缓存会抛出明确的「未启用」错误（不会静默降级成永远 miss）。
# REDIS_ENABLED=true
# 连接串（启用时必填）。带密码：redis://:PASSWORD@host:6379/0；TLS：rediss://host:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0
# 键前缀。多个应用 / 多套环境共用同一个 Redis 实例时靠它隔离命名空间
# REDIS_KEY_PREFIX=cache
# 建立连接超时（毫秒）
# REDIS_CONNECT_TIMEOUT=5000
# 单条命令超时（毫秒）。0 = 不限制
# REDIS_COMMAND_TIMEOUT=5000
# 断线后单条命令的最大重试次数，超过即快速失败，避免请求堆积
# REDIS_MAX_RETRIES_PER_REQUEST=3
# 独立密码（可选）。连接串里已含密码时无需重复设置
# REDIS_PASSWORD=

# ---------- 跨域（CORS） ----------
# 是否启用。不声明 = 启用；要关就写 false
# CORS_ENABLED=true
# 允许的来源：* 表示全部；或逗号分隔白名单（精确匹配）
# 例：CORS_ORIGIN=http://localhost:5173,https://admin.example.com
CORS_ORIGIN=*
# 是否允许携带凭据（Cookie / Authorization）。
# 注意：为 true 时 CORS_ORIGIN 不能是 *，否则启动直接报错（浏览器不接受这种组合）
CORS_CREDENTIALS=false
# 允许的方法（逗号分隔）。默认已覆盖 PUT/PATCH/DELETE，一般不用改
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
# 允许的请求头（逗号分隔）。不声明 = 反射浏览器实际请求的头（推荐留空）
# CORS_ALLOWED_HEADERS=Content-Type,Authorization
# 暴露给前端的响应头（逗号分隔）。不声明 = 不额外暴露
# CORS_EXPOSED_HEADERS=X-Request-Id
# 预检（OPTIONS）结果缓存秒数，0 = 不缓存
CORS_MAX_AGE=86400

# ---------- 接口文档（Swagger / OpenAPI） ----------
# 是否挂载接口文档。不声明该变量 = 非生产环境开启、生产环境关闭。
# 要显式控制就写 true / false；写空串属于配置错误，启动时会直接报出来。
# SWAGGER_ENABLED=true
# 挂载路径（不含前后斜杠），最终地址为 /<SWAGGER_PATH>，JSON 在 /<SWAGGER_PATH>/json
SWAGGER_PATH=docs
SWAGGER_TITLE=Nest Vben Admin API
# 支持 Markdown
SWAGGER_DESCRIPTION=
SWAGGER_VERSION=1.0.0

# ---------- 日志 ----------
# 注意：控制台输出由 Nest 自带的 ConsoleLogger 负责，样式不受这些变量影响。
# 以下配置只作用于 pino 写入的日志文件。
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# 是否写入日志文件：logs/app-YYYY-MM-DD.log（全量）、logs/error-YYYY-MM-DD.log（仅 error 及以上）
LOG_FILE=true
# 日志文件目录
LOG_DIR=logs
# 追加脱敏路径（逗号分隔）。默认已覆盖 authorization / cookie / password / token
# LOG_REDACT=req.headers["x-custom-secret"],*.idCard
